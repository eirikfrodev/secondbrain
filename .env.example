# Mock mode is the safe, credential-free default.
CONNECTOR_MODE=mock
NEXT_PUBLIC_CONNECTOR_MODE=mock

# Phase 2: add Supabase values locally. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: server/worker-only Google and encryption settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
