# Mock mode is the safe, credential-free default.
CONNECTOR_MODE=mock
NEXT_PUBLIC_CONNECTOR_MODE=mock

# Phase 2: set both connector modes to "supabase" and add these public values locally.
# Mock mode does not read or require either value. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Must be a low-privilege sb_publishable_ key; secret/service-role/JWT keys are rejected.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required only in Supabase mode. Use one exact HTTPS origin, or a loopback HTTP
# origin for local development; do not include a path, query, or credentials.
APP_ORIGIN=

# Reserved for future server/worker administration. Browser request paths in
# Phase 2 use only the caller-scoped publishable client and RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: server/worker-only Google execution and encryption settings. These
# future Gmail/Calendar credentials are separate from Google identity sign-in,
# whose client credentials belong only in Supabase Auth configuration.
GOOGLE_EXECUTION_CLIENT_ID=
GOOGLE_EXECUTION_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
