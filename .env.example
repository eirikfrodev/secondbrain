# Mock mode is the safe, credential-free default.
CONNECTOR_MODE=mock
NEXT_PUBLIC_CONNECTOR_MODE=mock

# Phase 2: set both connector modes to "supabase" and add these public values locally.
# Mock mode does not read or require either value. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Must be a low-privilege sb_publishable_ key; secret/service-role/JWT keys are rejected.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for future server/worker administration. Browser request paths in
# Phase 2 use only the caller-scoped publishable client and RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: server/worker-only Google and encryption settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
